{
  "name": "domain-swapper",
  "displayName": "Domain Swapper",
  "version": "2.0.10",
  "description": "Browser extension to allow swapping between hostnames quickly while preserving the rest of the URL ",
  "author": "Adam Norwood <adam@adamnorwood.com>",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "test": "plasmo test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@plasmohq/redux-persist": "^6.1.0",
    "@plasmohq/storage": "^1.15.0",
    "@reduxjs/toolkit": "^2.12.0",
    "lucide-react": "^1.41.0",
    "nanoid": "^6.0.1",
    "plasmo": "^0.90.5",
    "react": "^19.2.8",
    "react-redux": "^9.3.0",
    "redux-persist-webextension-storage": "^1.0.2"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "utopia-core-scss": "^1.3.1"
  },
  "manifest": {
